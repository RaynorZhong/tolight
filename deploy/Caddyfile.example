# Two separate Origins: static files and a TLS 1.3 participant reverse proxy.
# Local TLS spike: TOLIGHT_PARTICIPANT_ADDRESS=https://localhost:8443
# Configure network.trusted_proxies=["127.0.0.1"] when using this local proxy.
# Production: TOLIGHT_STATIC_ADDRESS=tolight.com
# Local spike: TOLIGHT_STATIC_ADDRESS=http://127.0.0.1:8081
# Both modes require TOLIGHT_PUBLIC_DIR to contain the assembled public tree.
{
	admin off
	http_port {$TOLIGHT_HTTP_PORT:80}
	# Do not change the host trust store during a localhost TLS spike.
	skip_install_trust
	servers {
		timeouts {
			read_header 10s
			read_body 15s
			idle 2m
		}
	}
}

(static_headers) {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Robots-Tag noindex
		Strict-Transport-Security max-age=31536000
		Cache-Control no-cache
		-Server
	}
}

{$TOLIGHT_STATIC_ADDRESS:tolight.com} {
	root * {$TOLIGHT_PUBLIC_DIR:/srv/tolight/public-dist}

	route {
		import static_headers

		@participant path /participant /participant/*
		respond @participant "Not Found" 404

		@unsupported not method GET HEAD
		header @unsupported Allow "GET, HEAD"
		respond @unsupported "Method Not Allowed" 405

		# Match decoded paths, including percent-encoded dots/slashes. The only
		# published dot-directory resource is the exact RFC 9116 endpoint.
		@hidden `path_regexp(r'(^|/)\.') && !path_regexp(r'^/\.well-known/security\.txt$')`
		respond @hidden "Not Found" 404

		@markdown path *.md
		header @markdown Content-Type "text/markdown; charset=utf-8"
		@python path *.py
		header @python Content-Type "text/plain; charset=utf-8"

		# No browse or SPA fallback. Caddy's ETag uses file mtime plus size.
		# Do not preserve an old mtime when atomically replacing different content.
		file_server {
			hide *.tmp .git .env
		}
	}

	handle_errors {
		import static_headers
		respond "{http.error.status_text}" {http.error.status_code}
	}
}

# No access log directive: signed headers, request bodies and client IPs are not logged.
{$TOLIGHT_PARTICIPANT_ADDRESS:api.tolight.com} {
	tls {
		protocols tls1.3
	}
	header {
		Cache-Control no-store
		X-Content-Type-Options nosniff
		Strict-Transport-Security max-age=31536000
		-Server
	}
	@participant path /participant/v1/*
	handle @participant {
		request_body {
			max_size 32KiB
		}
		reverse_proxy {$TOLIGHT_PARTICIPANT_UPSTREAM:127.0.0.1:8090} {
			header_up Host {http.request.hostport}
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Proto https
			header_up -Forwarded
			header_up -X-Forwarded-Host
			transport http {
				dial_timeout 3s
				response_header_timeout 45s
			}
		}
	}
	handle {
		respond "Not Found" 404
	}
	handle_errors {
		header Cache-Control no-store
		respond "{http.error.status_text}" {http.error.status_code}
	}
}
